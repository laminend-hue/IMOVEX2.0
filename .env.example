# --- Notifications email (Resend — https://resend.com) ---
# Créez un compte Resend gratuit, ajoutez votre domaine et copiez la clé API.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Email de l'administrateur qui reçoit les notifications de demandes de visite
ADMIN_NOTIFICATION_EMAIL=laminend2462@gmail.com
# Adresse expéditrice vérifiée dans Resend (doit appartenir à votre domaine)
FROM_EMAIL=notifications@imovex.sn

# --- Firebase App Check (reCAPTCHA v3) ---
# Obtenez votre clé sur https://www.google.com/recaptcha/admin
# Puis activez App Check + enforcement Firestore dans la console Firebase.
VITE_RECAPTCHA_V3_SITE_KEY=6Lc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Firebase Storage (photos persistantes — recommandé en production) ---
# Nom du bucket Firebase Storage (ex: gen-lang-client-0901041829.firebasestorage.app)
# Si absent, les photos sont stockées localement dans public/uploads/
FIREBASE_STORAGE_BUCKET=gen-lang-client-0901041829.firebasestorage.app

# --- Firebase Admin SDK (nécessaire pour l'upload vers Firebase Storage) ---
# Option A : chemin vers un fichier service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/serviceAccount.json
#
# Option B : contenu JSON du service account en ligne (pour déploiement cloud)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
